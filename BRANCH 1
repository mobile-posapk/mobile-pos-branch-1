  max-width: 430px;
  background: #ffffff;
  border-radius: 24px;
  padding: 24px;
  box-shadow: 0 20px 60px rgba(0,0,0,.25);
  animation: paymentModalIn .20s ease-out;
}

@keyframes paymentModalIn {
  from { opacity: 0; transform: translateY(20px) scale(.97); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}

.payment-modal-header { display:flex; align-items:center; justify-content:space-between; margin-bottom:20px; }
