const API_URL =
  "https://script.google.com/macros/s/AKfycbwXPoJ1VAIpqLEar3pAU0AOrp0XQkwcL8ovwcmj4553O3DgVPA87xrCE6QCojDaAtXAUw/exec";
  /* =================================================
     JSONP API HELPER
     GitHub Pages -> Google Apps Script
  ================================================= */

  function callPOSApi(action, params, success, failure) {

    const callbackName =
      "mobilePOSCallback_" + Date.now() + "_" +
      Math.floor(Math.random() * 1000000);

    const query = new URLSearchParams();
    query.set("action", action);
    query.set("callback", callbackName);

    if (params) {
      Object.keys(params).forEach(function(key) {
        query.set(key, String(params[key]));
      });
    }

    const script = document.createElement("script");
    let finished = false;

    function finish() {
      if (finished) return false;
      finished = true;
      clearTimeout(timeout);
      try { delete window[callbackName]; }
      catch (e) { window[callbackName] = undefined; }
      if (script.parentNode) script.parentNode.removeChild(script);
      return true;
    }

    const timeout = setTimeout(function() {
      if (!finish()) return;
      console.error("Mobile POS API timeout:", action);
      if (typeof failure === "function") {
        failure(new Error("The Mobile POS server did not respond."));
      }
    }, 12000);

    window[callbackName] = function(result) {
      if (!finish()) return;
      console.log("Mobile POS API response:", action, result);
      if (typeof success === "function") success(result);
    };

    script.onerror = function() {
      if (!finish()) return;
      console.error("Mobile POS API connection error:", action);
      if (typeof failure === "function") {
        failure(new Error("Unable to connect to the Mobile POS server."));
      }
    };

    const requestURL = API_URL + "?" + query.toString();
    console.log("Mobile POS API request:", requestURL);

    script.async = true;
    script.src = requestURL;
    document.head.appendChild(script);
  }


