  /* =================================================
   INVENTORY SEARCH
================================================= */

function setupInventorySearch() {

  const searchInput =
    document.getElementById(
      "inventorySearch"
    );

  if (!searchInput) {
    return;
  }


  /* Prevent duplicate listeners */

  if (
    searchInput.dataset.searchReady ===
    "true"
  ) {
    return;
  }


  searchInput.dataset.searchReady =
    "true";


  searchInput.addEventListener(
    "input",
    function() {

      const search =
        String(
          searchInput.value || ""
        )
        .trim()
        .toLowerCase();


      /* =========================================
         GET CURRENT INVENTORY
      ========================================= */

      if (
        !Array.isArray(
          window.inventoryProducts
        )
      ) {

        return;

      }


      /* =========================================
         FILTER
      ========================================= */

      const filteredProducts =
        window.inventoryProducts.filter(
          function(product) {

            if (!search) {
              return true;
            }


            const barcode =
              String(
                product.barcode || ""
              ).toLowerCase();


            const productId =
              String(
                product.productId || ""
              ).toLowerCase();


            const productName =
              String(
                product.productName || ""
              ).toLowerCase();


            return (

              barcode.includes(
                search
              ) ||

              productId.includes(
                search
              ) ||

              productName.includes(
                search
              )

            );

          }
        );


      /* =========================================
         RENDER FILTERED RESULTS
      ========================================= */

      renderInventory(
        filteredProducts
      );

    }
  );

}
/* =================================================
   UPDATE INVENTORY FILTER COUNTS
================================================= */

function updateInventoryFilterCounts() {

  if (
    !Array.isArray(
      window.inventoryProducts
    )
  ) {

    return;

  }


  let allCount =
    window.inventoryProducts.length;

  let availableCount = 0;

  let lowStockCount = 0;

  let outOfStockCount = 0;


  window.inventoryProducts.forEach(
    function(product) {

      const available =
        Number(
          product.available || 0
        );


      if (available <= 0) {

        outOfStockCount++;

      }

      else if (available <= 5) {

        lowStockCount++;

      }

      else {

        availableCount++;

      }

    }
  );


  /* =============================================
     UPDATE BUTTON COUNTS
  ============================================= */

  const filterButtons =
    document.querySelectorAll(
      ".inventory-filter-button"
    );


  filterButtons.forEach(
    function(button) {

      const filter =
        String(
          button.dataset.filter || ""
        ).toUpperCase();


      const countElement =
        button.querySelector(
          ".inventory-filter-count"
        );


      if (!countElement) {

        return;

      }


      let count = 0;


      if (filter === "ALL") {

        count =
          allCount;

      }

      else if (
        filter === "AVAILABLE"
      ) {

        count =
          availableCount;

      }

      else if (
        filter === "LOW STOCK"
      ) {

        count =
          lowStockCount;

      }

      else if (
        filter === "OUT OF STOCK"
      ) {

        count =
          outOfStockCount;

      }


      countElement.textContent =
        count;

    }
  );

}
  
function filterInventory(filter) {

  currentInventoryFilter =
    String(
      filter || "ALL"
    ).toUpperCase();


  /* =============================================
     UPDATE ACTIVE BUTTON
  ============================================= */

  const buttons =
    document.querySelectorAll(
      ".inventory-filter-button"
    );


  buttons.forEach(
    function(button) {

      const buttonFilter =
        String(
          button.dataset.filter || ""
        ).toUpperCase();


      if (
        buttonFilter ===
        currentInventoryFilter
      ) {

        button.classList.add(
          "active"
        );

      } else {

        button.classList.remove(
          "active"
        );

      }

    }
  );


  /* =============================================
     GET CURRENT INVENTORY DATA
  ============================================= */

  if (
    !Array.isArray(
      window.inventoryProducts
    )
  ) {

    console.warn(
      "Inventory products are not available."
    );

    return;

  }


  /* =============================================
     FILTER PRODUCTS
  ============================================= */

  let filteredProducts =
    window.inventoryProducts;


  if (
    currentInventoryFilter !==
    "ALL"
  ) {

    filteredProducts =
      window.inventoryProducts.filter(
        function(product) {

          const available =
            Number(
              product.available || 0
            );


          if (
            currentInventoryFilter ===
            "AVAILABLE"
          ) {

            return available > 5;

          }


          if (
            currentInventoryFilter ===
            "LOW STOCK"
          ) {

            return (
              available > 0 &&
              available <= 5
            );

          }


          if (
            currentInventoryFilter ===
            "OUT OF STOCK"
          ) {

            return available <= 0;

          }


          return true;

        }
      );

  }


  /* =============================================
     RENDER FILTERED PRODUCTS
  ============================================= */

  renderInventory(
    filteredProducts
  );

}

