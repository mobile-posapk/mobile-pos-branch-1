   POS ALERT MODAL
================================================= */

function showPOSAlert(title, productName, message, stockText, icon) {

  const modal = document.getElementById("posAlertModal");
  const titleElement = document.getElementById("posAlertTitle");
  const productElement = document.getElementById("posAlertProduct");
  const messageElement = document.getElementById("posAlertMessage");
  const stockElement = document.getElementById("posAlertStock");
  const iconElement = document.getElementById("posAlertIcon");

  if (!modal) {
    alert(
      String(title || "NOTICE") + "\n\n" +
      String(productName || "") + "\n\n" +
      String(message || "") +
      (stockText ? "\n" + stockText : "")
    );
    return;
  }

  titleElement.textContent = title || "NOTICE";
  productElement.textContent = productName || "";
  messageElement.textContent = message || "";
  iconElement.textContent = icon || "!";

  if (stockText) {
    stockElement.textContent = stockText;
    stockElement.style.display = "inline-flex";
  } else {
    stockElement.textContent = "";
    stockElement.style.display = "none";
  }

  modal.style.display = "flex";
}

function closePOSAlert() {
  const modal = document.getElementById("posAlertModal");
  if (modal) {
    modal.style.display = "none";
  }
}

/* =================================================
   CHECKOUT
================================================= */

/* =================================================
   PAYMENT MODAL STATE
================================================= */

let paymentTotalAmount = 0;


/* =================================================
   CHECKOUT
================================================= */

function checkout() {

  if (!cart || cart.length === 0) {
    alert("The cart is empty.");
    return;
  }

  let total = 0;

  cart.forEach(function(item) {
    total +=
      (Number(item.quantity) || 0) *
      (Number(item.unitPrice) || 0);
  });

  total = Number(total.toFixed(2));

  openPaymentModal(total);
}


/* =================================================
   OPEN PAYMENT MODAL
================================================= */

function openPaymentModal(total) {

  paymentTotalAmount = Number(total) || 0;

  const modal = document.getElementById("paymentModal");
  const totalElement = document.getElementById("paymentTotal");
  const cashInput = document.getElementById("cashReceived");
  const changeElement = document.getElementById("paymentChange");
  const messageElement = document.getElementById("paymentMessage");
  const completeButton = document.getElementById("completePaymentButton");

  if (!modal) {
    alert("Payment interface could not be loaded.");
    return;
  }

  totalElement.textContent = "₱" + formatMoney(paymentTotalAmount);
  cashInput.value = "";
  changeElement.textContent = "₱0.00";
  messageElement.style.display = "none";
  messageElement.textContent = "";
  completeButton.disabled = true;

  modal.style.display = "flex";

  setTimeout(function() {
    cashInput.focus();
  }, 150);
}


/* =================================================
   CLOSE PAYMENT MODAL
================================================= */

function closePaymentModal() {

  const modal = document.getElementById("paymentModal");

  if (modal) {
    modal.style.display = "none";
  }

  paymentTotalAmount = 0;
}


/* =================================================
   UPDATE PAYMENT AMOUNT
================================================= */

function updatePaymentAmount() {

  const cashInput = document.getElementById("cashReceived");
  const changeElement = document.getElementById("paymentChange");
  const messageElement = document.getElementById("paymentMessage");
  const completeButton = document.getElementById("completePaymentButton");

  const cash = Number(cashInput.value);

  if (cashInput.value === "" || !Number.isFinite(cash)) {
    changeElement.textContent = "₱0.00";
    messageElement.style.display = "none";
    completeButton.disabled = true;
    return;
  }

  const change = Number((cash - paymentTotalAmount).toFixed(2));

  if (change < 0) {
    changeElement.textContent = "₱0.00";
    messageElement.textContent =
      "Insufficient cash. Short by ₱" + Math.abs(change).toFixed(2);
    messageElement.style.display = "block";
    messageElement.style.background = "#fee2e2";
    messageElement.style.color = "#991b1b";
    completeButton.disabled = true;
    return;
  }

  changeElement.textContent = "₱" + change.toFixed(2);
  messageElement.textContent = "Payment is ready.";
  messageElement.style.display = "block";
  messageElement.style.background = "#ecfdf5";
  messageElement.style.color = "#065f46";
  completeButton.disabled = false;
}


/* =================================================
   COMPLETE PAYMENT
================================================= */

function completePayment() {

  const cashInput = document.getElementById("cashReceived");
  const cash = Number(cashInput.value);

  if (!Number.isFinite(cash) || cash < paymentTotalAmount) {
    updatePaymentAmount();
    return;
  }

  const change = Number((cash - paymentTotalAmount).toFixed(2));

  closePaymentModal();
  processCheckoutPayment(cash, change);
}


/* =================================================
   TRANSACTION RECEIPT
================================================= */

function openReceiptModal(data) {

  const modal = document.getElementById("receiptModal");
  if (!modal) {
    return;
  }

  document.getElementById("receiptTransactionId").textContent =
    data.transactionId || "N/A";

  document.getElementById("receiptItems").textContent =
    Number(data.items || 0).toLocaleString();

  document.getElementById("receiptTotal").textContent =
    "₱" + formatMoney(Number(data.total) || 0);

  document.getElementById("receiptCash").textContent =
    "₱" + formatMoney(Number(data.cash) || 0);

  document.getElementById("receiptChange").textContent =
    "₱" + formatMoney(Number(data.change) || 0);

  document.getElementById("receiptPaid").textContent =
    "₱" + formatMoney(Number(data.cash) || 0);

  modal.style.display = "flex";
}

function closeReceiptModal() {
  const modal = document.getElementById("receiptModal");
  if (modal) {
    modal.style.display = "none";
  }
}


/* =================================================
   PROCESS CHECKOUT PAYMENT
================================================= */

function processCheckoutPayment(cash, change) {

  if (!cart || cart.length === 0) {
    return;
  }

  let total = 0;

  cart.forEach(function(item) {
    total +=
      (Number(item.quantity) || 0) *
      (Number(item.unitPrice) || 0);
  });

  total = Number(total.toFixed(2));

  const checkoutData = {
    items: cart.map(function(item) {
      return {
        barcode: item.barcode,
        productId: item.productId,
        productName: item.productName,
        unitPrice: Number(item.unitPrice) || 0,
        quantity: Number(item.quantity) || 0
      };
    }),
    cash: Number(cash),
    change: Number(change),
    total: Number(total)
  };

  console.log("CHECKOUT DATA:", checkoutData);

  const checkoutButton = document.getElementById("checkoutButton");

  if (checkoutButton) {
    checkoutButton.disabled = true;
    checkoutButton.textContent = "PROCESSING...";
  }

  callPOSApi(
    "checkout",
    { data: JSON.stringify(checkoutData) },
    function(result) {

      console.log("CHECKOUT RESPONSE:", result);

      if (checkoutButton) {
        checkoutButton.disabled = false;
        checkoutButton.textContent = "CHECKOUT";
      }

      if (!result || result.success !== true) {
        alert(
          "CHECKOUT FAILED.\n\n" +
          (result && result.message
            ? result.message
            : "Unable to complete transaction.")
        );
        return;
      }

      const transactionId = result.transactionId || "N/A";
      const finalTotal = Number(result.total ?? total);
      const finalCash = Number(result.cash ?? cash);
      const finalChange = Number(result.change ?? change);

      const cartItemCountForReceipt = cart.reduce(function(sum, item) {
        return sum + (Number(item.quantity) || 0);
      }, 0);

      cart = [];
      renderCart();
      setScannerStatus("Scanner ready — scan a product");

      openReceiptModal({
        transactionId: transactionId,
        items: cartItemCountForReceipt,
        total: finalTotal,
        cash: finalCash,
        change: finalChange
      });

      loadDashboard();
    },
    function(error) {

      console.error("CHECKOUT ERROR:", error);

      if (checkoutButton) {
        checkoutButton.disabled = false;
        checkoutButton.textContent = "CHECKOUT";
      }

      alert(
        "CHECKOUT FAILED.\n\n" +
        (error && error.message
          ? error.message
          : "Unable to connect to the Mobile POS server.")
      );
    }
  );
}


/* =================================================
   PAYMENT INPUT LISTENER
================================================= */

document.addEventListener("input", function(event) {
  if (event.target && event.target.id === "cashReceived") {
    updatePaymentAmount();
  }
});


  /* =================================================
     LOAD DASHBOARD
  ================================================= */

  function loadDashboard() {

    callPOSApi(
      "dashboard",
      {},
      function(data) {
        if (!data) return;

        const sales = Number(data.todaySales || 0);
        const transactions = Number(data.todayTransactions || 0);
        const totalProducts = Number(data.totalProducts || 0);
        const totalAvailable = Number(data.totalAvailable || 0);
        const lowStock = Number(data.lowStock || 0);
        const outOfStock = Number(data.outOfStock || 0);

        const el = id => document.getElementById(id);

        if (el("todaySales")) {
          el("todaySales").textContent = "₱" + sales.toLocaleString("en-PH", {minimumFractionDigits:2, maximumFractionDigits:2});
        }
        if (el("todayTransactions")) {
          el("todayTransactions").textContent = transactions + (transactions === 1 ? " transaction today" : " transactions today");
        }
        if (el("totalProducts")) el("totalProducts").textContent = totalProducts.toLocaleString();
        if (el("totalAvailable")) el("totalAvailable").textContent = totalAvailable.toLocaleString();
        if (el("availableStatus")) el("availableStatus").textContent = totalAvailable.toLocaleString();
        if (el("lowStock")) el("lowStock").textContent = lowStock.toLocaleString();
        if (el("outOfStock")) el("outOfStock").textContent = outOfStock.toLocaleString();
      },
      function(error) {
        console.error("Dashboard API error:", error);
      }
    );
  }


  /* =================================================
     INITIALIZE APP
  ================================================= */

  document.addEventListener(
    "DOMContentLoaded",
    function() {
      const loading = document.getElementById("loading");
      if (loading) loading.style.display = "none";
      loadDashboard();
      renderCart();
    }
  );

/* =================================================
   BARCODE SCANNER
================================================= */

let barcodeScanner = null;

let scannerRunning = false;

let lastScannedBarcode = "";

let lastScanTime = 0;
/* =================================================
   START SCANNER
================================================= */

function startBarcodeScanner() {

  if (scannerRunning) {
    return;
  }


  /*
   * Make sure the scanner library loaded.
   */

  if (
    typeof Html5Qrcode ===
    "undefined"
  ) {

    alert(
      "Barcode scanner library could not be loaded."
    );

    return;

  }


  const reader =
    document.getElementById(
      "barcode-reader"
    );


  if (!reader) {
    return;
  }


  /*
   * Create scanner.
   */

  barcodeScanner =
    new Html5Qrcode(
      "barcode-reader"
    );


  /*
   * Barcode formats supported by
   * common retail products.
   */

  const formatsToSupport = [

    Html5QrcodeSupportedFormats.EAN_13,

    Html5QrcodeSupportedFormats.EAN_8,

    Html5QrcodeSupportedFormats.UPC_A,

    Html5QrcodeSupportedFormats.UPC_E,

    Html5QrcodeSupportedFormats.CODE_128,

    Html5QrcodeSupportedFormats.CODE_39,

    Html5QrcodeSupportedFormats.ITF,

    Html5QrcodeSupportedFormats.CODABAR

  ];


  const config = {

    fps: 10,

    qrbox: {

      width: 260,

      height: 130

    },

    formatsToSupport:
      formatsToSupport,

    aspectRatio: 1.777

  };


  barcodeScanner
    .start(

      {
        facingMode: "environment"
      },

      config,

      onBarcodeDetected,

      onBarcodeScanError

    )

    .then(function() {

      scannerRunning = true;

      setScannerStatus(
        "Scanner ready — scan a product"
      );

    })

    .catch(function(error) {

      scannerRunning = false;

      console.error(
        "Scanner error:",
        error
      );


      setScannerStatus(
        "Camera could not be started"
      );


      alert(
        "Unable to start the barcode scanner.\n\n" +
        "Please allow camera access for this web app."
      );

    });

}



/* =================================================
   BARCODE DETECTED
================================================= */

function onBarcodeDetected(decodedText, decodedResult) {

  const barcode = String(decodedText || "").trim();
  if (!barcode) return;

  const now = Date.now();
  if (barcode === lastScannedBarcode && now - lastScanTime < 1500) return;

  lastScannedBarcode = barcode;
  lastScanTime = now;

  setScannerStatus("Product detected: " + barcode);
  playBarcodeScanSound();
  console.log("Barcode detected:", barcode);

  callPOSApi(
    "product",
    { barcode: barcode },
    function(result) {

      console.log("Product lookup result:", result);

      if (!result || result.success !== true || result.found !== true || !result.product) {
        setScannerStatus("Product not found: " + barcode);
        stopBarcodeScanner();
        showRegisterProductPrompt(barcode);
        return;
      }

      addProductToCart(result.product);
      setScannerStatus(String(result.product.productName || "Product") + " added");
      setTimeout(function() { setScannerStatus("Scanner ready — scan next product"); }, 1000);
    },
    function(error) {
      console.error("Product lookup failed:", error);
      setScannerStatus("Database connection failed");
      setTimeout(function() { setScannerStatus("Scanner ready — scan a product"); }, 2000);
    }
  );
}


/* =================================================
   SCANNER ERROR CALLBACK
================================================= */

function onBarcodeScanError(errorMessage) {

  /*
   * Ignore normal scan failures.
   *
   * The library generates many of these
   * while it is simply looking for a barcode.
   */

}



/* =================================================
   SCANNER STATUS
================================================= */

function setScannerStatus(message) {


  let status =
    document.getElementById(
      "scannerStatus"
    );


  if (!status) {

    status =
      document.createElement(
        "div"
      );


    status.id =
      "scannerStatus";


    status.className =
      "scanner-status";


    const scannerCard =
      document.querySelector(
        ".scanner-card"
      );


    if (scannerCard) {

      scannerCard.appendChild(
        status
      );

    }

  }


  status.textContent =
    message;

}



/* =================================================
   STOP SCANNER
================================================= */

function stopBarcodeScanner() {


  if (
    !barcodeScanner ||
    !scannerRunning
  ) {

    return;

  }


  barcodeScanner
    .stop()

    .then(function() {

      scannerRunning = false;

      setScannerStatus(
        "Scanner stopped"
      );

    })

    .catch(function(error) {

      console.error(error);

      scannerRunning = false;

    });

}



/* =================================================
   START WHEN POS OPENS
================================================= */

const originalShowPage =
  showPage;


showPage = function(page) {


  originalShowPage(page);


  if (page === "pos") {

    /*
     * Give the POS page a moment to
     * become visible before starting
     * the camera.
     */

    setTimeout(
      function() {

        startBarcodeScanner();

      },
      300
    );

  }

  else {

    stopBarcodeScanner();

  }

};

