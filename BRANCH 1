function addProductToCart(product) {


  /*
   * Check whether product already exists
   * in the current cart.
   */

  const existing =
    cart.find(
      item =>
        String(item.barcode) ===
        String(product.barcode)
    );


  if (existing) {


    /*
     * Don't allow quantity to exceed stock.
     */

    if (
      existing.quantity >=
      Number(product.available)
    ) {

      showPOSAlert(
        "INSUFFICIENT STOCK",
        product.productName,
        "You cannot add more of this product than the available stock.",
        "Available stock: " + product.available,
        "⚠"
      );

      return;

    }


    existing.quantity++;


  } else {


    if (
      Number(product.available) <= 0
    ) {

      showPOSAlert(
        "OUT OF STOCK",
        product.productName,
        "This product is currently unavailable and cannot be added to the order.",
        "Available stock: 0",
        "!"
      );

      return;

    }


    cart.push({

      barcode:
        product.barcode,

      productId:
        product.productId,

      productName:
        product.productName,

      unitPrice:
        Number(product.price) || 0,

      quantity: 1,

      available:
        Number(product.available) || 0

    });

  }


  renderCart();

}



/* =================================================
   CHANGE QUANTITY
================================================= */

function changeQuantity(index, amount) {


  const item = cart[index];


  if (!item) return;


  const newQuantity =
    item.quantity + amount;


  if (newQuantity <= 0) {

    removeCartItem(index);

    return;

  }


  if (
    newQuantity >
    Number(item.available)
  ) {

    alert(
      "Only " +
      item.available +
      " available."
    );

    return;

  }


  item.quantity =
    newQuantity;


  renderCart();

}



/* =================================================
   REMOVE ITEM
================================================= */

function removeCartItem(index) {

  cart.splice(index, 1);

  renderCart();

}



/* =================================================
   CLEAR CART
================================================= */

function clearCart() {


  if (cart.length === 0) {
    return;
  }


  if (
    !confirm(
      "Clear all products from the cart?"
    )
  ) {

    return;

  }


  cart = [];

  renderCart();

}



/* =================================================
   RENDER CART
================================================= */

function renderCart() {


  const container =
    document.getElementById(
      "cartItems"
    );


  const emptyCart =
    document.getElementById(
      "emptyCart"
    );


  const checkoutButton =
    document.getElementById(
      "checkoutButton"
    );


  if (cart.length === 0) {


    container.innerHTML = "";

    emptyCart.style.display =
      "block";

    checkoutButton.disabled =
      true;


    updateCartTotals();

    return;

  }


  emptyCart.style.display =
    "none";


  checkoutButton.disabled =
    false;


  container.innerHTML =
    cart.map(
      (item, index) => {


        const subtotal =
          item.quantity *
          item.unitPrice;


        return `

          <div class="cart-item">

            <div class="cart-item-top">

              <div>

                <div class="cart-product-name">
                  ${escapeHtml(
                    item.productName
                  )}
                </div>

                <div class="cart-barcode">
                  ${escapeHtml(
                    String(item.barcode)
                  )}
                </div>

              </div>


              <div class="cart-item-price">

                ₱${formatMoney(
                  item.unitPrice
                )}

              </div>

            </div>


            <div class="cart-controls">


              <div class="quantity-controls">


                <button
                  class="quantity-button"
                  onclick="
                    changeQuantity(
                      ${index},
                      -1
                    )
                  ">

                  −

                </button>


                <div
                  class="quantity-value">

                  ${item.quantity}

                </div>


                <button
                  class="quantity-button"
                  onclick="
                    changeQuantity(
                      ${index},
                      1
                    )
                  ">

                  +

                </button>


                <button
                  class="remove-item"
                  onclick="
                    removeCartItem(
                      ${index}
                    )
                  ">

                  Remove

                </button>


              </div>


              <div class="item-subtotal">

                ₱${formatMoney(
                  subtotal
                )}

              </div>


            </div>

          </div>

        `;

      }
    )
    .join("");


  updateCartTotals();

}



/* =================================================
   CART TOTALS
================================================= */

function updateCartTotals() {


  let itemCount = 0;

  let total = 0;


  cart.forEach(item => {

    itemCount +=
      Number(item.quantity);

    total +=
      Number(item.quantity) *
      Number(item.unitPrice);

  });


  document.getElementById(
    "cartItemCount"
  ).textContent =
    itemCount;


  document.getElementById(
    "cartSubtotal"
  ).textContent =
    "₱" +
    formatMoney(total);


  document.getElementById(
    "cartTotal"
  ).textContent =
    "₱" +
    formatMoney(total);

}



/* =================================================
   MONEY
================================================= */

function formatMoney(value) {

  return Number(value || 0)
    .toLocaleString(
      "en-PH",
      {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2
      }
    );

}



/* =================================================
   HTML SAFETY
================================================= */

function escapeHtml(value) {

  return String(value)
    .replace(
      /&/g,
      "&amp;"
    )
    .replace(
      /</g,
      "&lt;"
    )
    .replace(
      />/g,
      "&gt;"
    )
    .replace(
      /"/g,
      "&quot;"
    )
    .replace(
      /'/g,
      "&#039;"
    );

}




