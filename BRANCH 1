.payment-label { font-size:12px; font-weight:700; letter-spacing:1px; color:#6b7280; }
.payment-total { margin-top:5px; font-size:36px; font-weight:900; color:#111827; }
.payment-input-section { margin-bottom:18px; }
.payment-input-label { display:block; margin-bottom:8px; font-size:13px; font-weight:800; color:#374151; }
.payment-input-wrapper { display:flex; align-items:center; border:2px solid #d1d5db; border-radius:16px; background:#fff; overflow:hidden; }
.payment-input-wrapper:focus-within { border-color:#111827; box-shadow:0 0 0 3px rgba(17,24,39,.10); }
.payment-currency { padding-left:18px; font-size:24px; font-weight:800; color:#374151; }
#cashReceived { width:100%; border:none; outline:none; padding:16px; font-size:28px; font-weight:800; background:transparent; color:#111827; box-sizing:border-box; }
#cashReceived::placeholder { color:#d1d5db; }
.payment-change-box { display:flex; align-items:center; justify-content:space-between; padding:16px 18px; border-radius:16px; background:#f9fafb; margin-bottom:12px; }
.payment-change-label { font-size:14px; font-weight:800; color:#6b7280; }
.payment-change { font-size:24px; font-weight:900; color:#111827; }
.payment-message { padding:12px 14px; border-radius:12px; margin-bottom:14px; font-size:13px; font-weight:700; text-align:center; }
.payment-buttons { display:flex; gap:10px; margin-top:10px; }
.payment-cancel-button, .payment-complete-button { flex:1; min-height:54px; border:none; border-radius:15px; font-size:14px; font-weight:800; cursor:pointer; }
.payment-cancel-button { background:#f3f4f6; color:#374151; }
.payment-complete-button { background:#111827; color:#fff; }
.payment-complete-button:disabled { background:#d1d5db; color:#9ca3af; cursor:not-allowed; }

@media (max-width:480px) {
