<!DOCTYPE html>
<html>

<head>

  <base target="_top">
  <script src="https://unpkg.com/html5-qrcode" type="text/javascript"></script>

  <meta name="viewport"
        content="width=device-width,
                 initial-scale=1,
                 maximum-scale=1,
                 user-scalable=no">

  <title>Mobile POS</title>


  <style>

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }


    html,
    body {
      width: 100%;
      min-height: 100%;
    }


    body {

      font-family:
        Arial,
        Helvetica,
        sans-serif;

      background: #f4f6f8;

      color: #111827;

      -webkit-tap-highlight-color:
        transparent;

    }


    button,
    input {
      font-family: inherit;
    }


    button {
      cursor: pointer;
    }


    /* =================================================
       APP
    ================================================= */

    .app {

      width: 100%;

      max-width: 600px;

      min-height: 100vh;

      margin: auto;

      background: #ffffff;

      position: relative;

      overflow-x: hidden;

    }


    /* =================================================
       HEADER
    ================================================= */

    .top-header {

      background: #111827;

      color: #ffffff;

      padding:
        20px
        20px
        18px;

      position: sticky;

      top: 0;

      z-index: 50;

    }


    .brand {

      display: flex;

      align-items: center;

      gap: 12px;

    }


    .brand-icon {

      width: 44px;

      height: 44px;

      border-radius: 13px;

      background: #ffffff;

      display: flex;

      align-items: center;

      justify-content: center;

      font-size: 24px;

    }


    .brand-name {

      font-size: 21px;

      font-weight: 700;

    }


    .brand-subtitle {

      margin-top: 3px;

      font-size: 12px;

      opacity: .7;

    }


    /* =================================================
       PAGE
    ================================================= */

    .page {

      display: none;

      padding:
        20px
        20px
        100px;

      min-height: calc(100vh - 82px);

    }


    .page.active {
      display: block;
    }


    /* =================================================
       PAGE TITLE
    ================================================= */

    .page-heading {

      margin-bottom: 18px;

    }


    .page-title {

      font-size: 25px;

      font-weight: 700;

    }


    .page-description {

      margin-top: 5px;

      color: #6b7280;

      font-size: 13px;

      line-height: 1.5;

    }


    /* =================================================
       SALES CARD
    ================================================= */

    .sales-card {

      background: #111827;

      color: white;

      border-radius: 20px;

      padding: 22px;

      margin-bottom: 18px;

      position: relative;

      overflow: hidden;

    }


    .sales-card::after {

      content: "";

      position: absolute;

      width: 130px;

      height: 130px;

      border-radius: 50%;

      background: rgba(255,255,255,.05);

      right: -45px;

      top: -45px;

    }


    .sales-label {

      font-size: 12px;

      opacity: .7;

      letter-spacing: .5px;

    }


    .sales-value {

      font-size: 34px;

      font-weight: 700;

      margin-top: 7px;

    }


    .sales-today {

      margin-top: 6px;

      font-size: 12px;

      opacity: .7;

    }


    /* =================================================
       STAT GRID
    ================================================= */

    .stats-grid {

      display: grid;

      grid-template-columns:
        1fr 1fr;

      gap: 12px;

      margin-bottom: 22px;

    }


    .stat-card {

      border: 1px solid #e5e7eb;

      background: #ffffff;

      border-radius: 17px;

      padding: 17px;

    }


    .stat-icon {

      font-size: 24px;

      margin-bottom: 10px;

    }


    .stat-label {

      font-size: 12px;

      color: #6b7280;

    }


    .stat-value {

      font-size: 24px;

      font-weight: 700;

      margin-top: 5px;

    }


    /* =================================================
       SECTION
    ================================================= */

    .section {

      margin-top: 22px;

    }


    .section-header {

      display: flex;

      justify-content: space-between;

      align-items: center;

      margin-bottom: 12px;

    }


    .section-title {

      font-size: 17px;

      font-weight: 700;

    }


    /* =================================================
       ACTION GRID
    ================================================= */

    .action-grid {

      display: grid;

      grid-template-columns:
        1fr 1fr;

      gap: 12px;

    }


    .action {

      border: none;

      border-radius: 18px;

      padding: 20px 12px;

      background: #f3f4f6;

      text-align: left;

      min-height: 105px;

      transition:
        transform .1s ease;

    }


    .action:active {

      transform: scale(.97);

    }


    .action-icon {

      font-size: 29px;

      margin-bottom: 10px;

    }


    .action-title {

      display: block;

      font-size: 15px;

      font-weight: 700;

    }


    .action-description {

      display: block;

      margin-top: 4px;

      color: #6b7280;

      font-size: 11px;

    }


    /* =================================================
       INVENTORY STATUS
    ================================================= */

    .inventory-status {

      display: grid;

      grid-template-columns:
        1fr 1fr 1fr;

      gap: 9px;

    }


    .status-card {

      border-radius: 15px;

      padding: 14px 10px;

      text-align: center;

      background: #f3f4f6;

    }


    .status-number {

      font-size: 21px;

      font-weight: 700;

    }


    .status-label {

      margin-top: 4px;

      font-size: 10px;

      color: #6b7280;

    }


    /* =================================================
       PLACEHOLDER PAGES
    ================================================= */

    .empty-page {

      min-height: 50vh;

      display: flex;

      flex-direction: column;

      align-items: center;

      justify-content: center;

      text-align: center;

      color: #6b7280;

    }


    .empty-icon {

      font-size: 55px;

      margin-bottom: 15px;

    }


    .empty-title {

      color: #111827;

      font-size: 21px;

      font-weight: 700;

    }


    .empty-text {

      max-width: 300px;

      margin-top: 7px;

      font-size: 13px;

      line-height: 1.5;

    }


    /* =================================================
       BOTTOM NAV
    ================================================= */

    .bottom-nav {

      position: fixed;

      bottom: 0;

      left: 50%;

      transform: translateX(-50%);

      width: 100%;

      max-width: 600px;

      height: 76px;

      background: rgba(
        255,
        255,
        255,
        .97
      );

      border-top:
        1px solid #e5e7eb;

      display: grid;

      grid-template-columns:
        repeat(4, 1fr);

      z-index: 100;

      padding-bottom:
        env(safe-area-inset-bottom);

    }


    .nav-item {

      border: none;

      background: transparent;

      color: #6b7280;

      display: flex;

      flex-direction: column;

      align-items: center;

      justify-content: center;

      gap: 4px;

      position: relative;

    }


    .nav-item.active {

      color: #111827;

      font-weight: 700;

    }


    .nav-item.active::before {

      content: "";

      position: absolute;

      top: 0;

      left: 25%;

      right: 25%;

      height: 3px;

      background: #111827;

      border-radius:
        0 0 5px 5px;

    }


    .nav-icon {

      font-size: 21px;

    }


    .nav-label {

      font-size: 10px;

    }


    /* =================================================
       LOADING
    ================================================= */

    .loading {

      position: fixed;

      inset: 0;

      background:
        rgba(255,255,255,.85);

      z-index: 999;

      display: flex;

      align-items: center;

      justify-content: center;

    }


    .loading-box {

      background: white;

      border-radius: 17px;

      padding: 20px 25px;

      box-shadow:
        0 10px 35px
        rgba(0,0,0,.12);

      text-align: center;

    }


    .spinner {

      width: 30px;

      height: 30px;

      border:
        3px solid #e5e7eb;

      border-top-color:
        #111827;

      border-radius: 50%;

      animation:
        spin .7s linear infinite;

      margin: auto auto 10px;

    }


    @keyframes spin {

      to {
        transform: rotate(360deg);
      }

    }


    /* =================================================
       RESPONSIVE
    ================================================= */

    @media (max-width: 380px) {

      .page {

        padding:
          17px
          15px
          95px;

      }

      .sales-value {

        font-size: 29px;

      }

      .action {

        min-height: 98px;

      }

    }

/* =================================================
   POS SCANNER
================================================= */

.scanner-card {

  background: #111827;

  color: white;

  border-radius: 20px;

  padding: 16px;

  margin-bottom: 20px;

}


.scanner-header {

  display: flex;

  justify-content: space-between;

  align-items: center;

  margin-bottom: 14px;

}


.scanner-title {

  font-size: 17px;

  font-weight: 700;

}


.scanner-subtitle {

  margin-top: 4px;

  font-size: 11px;

  opacity: .65;

}


.scanner-icon {

  width: 42px;

  height: 42px;

  border-radius: 13px;

  background: rgba(255,255,255,.08);

  display: flex;

  align-items: center;

  justify-content: center;

  font-size: 22px;

}


/* SCANNER BOX */

.scanner-box {

  height: 230px;

  border-radius: 15px;

  background: #050505;

  position: relative;

  overflow: hidden;

  display: flex;

  align-items: center;

  justify-content: center;

}


.scanner-message {

  text-align: center;

  color: rgba(255,255,255,.75);

  font-size: 14px;

}


.scanner-message small {

  display: block;

  margin-top: 7px;

  font-size: 10px;

  color: rgba(255,255,255,.45);

}


.scanner-camera-icon {

  font-size: 35px;

  margin-bottom: 8px;

  opacity: .8;

}


/* SCANNER CORNERS */

.scanner-corners {

  position: absolute;

  inset: 35px;

}


.corner {

  position: absolute;

  width: 35px;

  height: 35px;

  border-color: rgba(255,255,255,.8);

  border-style: solid;

}


.top-left {

  top: 0;

  left: 0;

  border-width: 3px 0 0 3px;

}


.top-right {

  top: 0;

  right: 0;

  border-width: 3px 3px 0 0;

}


.bottom-left {

  bottom: 0;

  left: 0;

  border-width: 0 0 3px 3px;

}


.bottom-right {

  bottom: 0;

  right: 0;

  border-width: 0 3px 3px 0;

}


/* SCANNER LINE */

.scanner-line {

  position: absolute;

  left: 35px;

  right: 35px;

  top: 50%;

  height: 2px;

  background: rgba(255,255,255,.65);

  opacity: .65;

}


/* MANUAL BARCODE */

.manual-scan {

  display: flex;

  gap: 8px;

  margin-top: 12px;

}


.manual-scan input {

  flex: 1;

  min-width: 0;

  height: 45px;

  border: none;

  border-radius: 11px;

  padding: 0 13px;

  background: rgba(255,255,255,.1);

  color: white;

  outline: none;

}


.manual-scan input::placeholder {

  color: rgba(255,255,255,.45);

}


.manual-scan button {

  width: 70px;

  border: none;

  border-radius: 11px;

  background: white;

  color: #111827;

  font-weight: 700;

}



/* =================================================
   CART
================================================= */

.cart-section {

  margin-bottom: 15px;

}


.cart-header {

  display: flex;

  justify-content: space-between;

  align-items: center;

  margin-bottom: 12px;

}


.cart-title {

  font-size: 18px;

  font-weight: 700;

}


.clear-cart-button {

  border: none;

  background: transparent;

  color: #6b7280;

  font-size: 12px;

  padding: 6px;

}


.cart-items {

  display: flex;

  flex-direction: column;

  gap: 10px;

}


.cart-item {

  border: 1px solid #e5e7eb;

  border-radius: 16px;

  padding: 15px;

  background: white;

}


.cart-item-top {

  display: flex;

  justify-content: space-between;

  gap: 10px;

}


.cart-product-name {

  font-size: 15px;

  font-weight: 700;

}


.cart-barcode {

  margin-top: 3px;

  color: #9ca3af;

  font-size: 10px;

}


.cart-item-price {

  font-size: 15px;

  font-weight: 700;

  white-space: nowrap;

}


.cart-controls {

  display: flex;

  align-items: center;

  justify-content: space-between;

  margin-top: 13px;

}


.quantity-controls {

  display: flex;

  align-items: center;

  gap: 8px;

}


.quantity-button {

  width: 34px;

  height: 34px;

  border: 1px solid #e5e7eb;

  border-radius: 9px;

  background: #f9fafb;

  font-size: 18px;

}


.quantity-value {

  width: 35px;

  text-align: center;

  font-weight: 700;

}


.item-subtotal {

  font-size: 13px;

  color: #6b7280;

}


.remove-item {

  border: none;

  background: transparent;

  color: #9ca3af;

  font-size: 11px;

  margin-left: 10px;

}


.remove-item:active {

  color: #111827;

}



/* =================================================
   EMPTY CART
================================================= */

.empty-cart {

  text-align: center;

  padding: 35px 20px;

  border:
    1px dashed #d1d5db;

  border-radius: 16px;

  color: #9ca3af;

}


.empty-cart-icon {

  font-size: 40px;

  margin-bottom: 8px;

}


.empty-cart-title {

  color: #374151;

  font-weight: 700;

  font-size: 15px;

}


.empty-cart-text {

  margin-top: 5px;

  font-size: 11px;

}



/* =================================================
   TOTAL CARD
================================================= */

.total-card {

  background: #f3f4f6;

  border-radius: 19px;

  padding: 18px;

  margin-bottom: 20px;

}


.total-row {

  display: flex;

  justify-content: space-between;

  align-items: center;

  color: #6b7280;

  font-size: 13px;

  margin-bottom: 9px;

}


.total-row strong {

  color: #111827;

}


.total-divider {

  height: 1px;

  background: #d1d5db;

  margin: 13px 0;

}


.grand-total-row {

  display: flex;

  justify-content: space-between;

  align-items: center;

  margin-bottom: 16px;

}


.grand-total-row span {

  font-size: 15px;

  font-weight: 700;

}


.grand-total-row strong {

  font-size: 27px;

}


.checkout-button {

  width: 100%;

  height: 53px;

  border: none;

  border-radius: 14px;

  background: #111827;

  color: white;

  font-size: 15px;

  font-weight: 700;

}


.checkout-button:disabled {

  background: #d1d5db;

  color: #9ca3af;

  cursor: not-allowed;

}

/* =================================================
   REAL BARCODE SCANNER
================================================= */

.barcode-reader {

  width: 100%;

  height: 100%;

  overflow: hidden;

  background: #050505;

}


/*
 * html5-qrcode generates the video element
 * automatically.
 */

.barcode-reader video {

  width: 100% !important;

  height: 100% !important;

  object-fit: cover !important;

}


/*
 * Hide the library's default controls.
 */

.barcode-reader img {

  display: none !important;

}


.barcode-reader__dashboard {

  padding: 0 !important;

}


.barcode-reader__dashboard_section {

  padding: 0 !important;

}


.barcode-reader__camera_selection {

  display: none !important;

}


/*
 * Scanner border.
 */

.scanner-box {

  border:
    2px solid
    rgba(255,255,255,.25);

}


/*
 * Scanner status.
 */

.scanner-status {

  margin-top: 10px;

  text-align: center;

  font-size: 11px;

  color: rgba(255,255,255,.65);

}


/*
 * Start scanner button.
 */

.start-scanner-button {

  width: 100%;

  height: 45px;

  margin-top: 10px;

  border: none;

  border-radius: 11px;

  background: white;

  color: #111827;

  font-weight: 700;

}


/*
 * Stop scanner button.
 */

.stop-scanner-button {

  width: 100%;

  height: 42px;

  margin-top: 8px;

  border: none;

  border-radius: 11px;

  background: rgba(255,255,255,.1);

  color: white;

  font-size: 12px;

}

  

/* =================================================
   TRANSACTION RECEIPT MODAL
================================================= */

.receipt-modal {
  position: fixed;
  inset: 0;
  z-index: 100001;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20px;
}

.receipt-overlay {
  position: absolute;
  inset: 0;
  background: rgba(0,0,0,.62);
  backdrop-filter: blur(5px);
}

.receipt-box {
  position: relative;
  width: 100%;
  max-width: 430px;
  background: #fff;
  border-radius: 26px;
  padding: 28px 24px 22px;
  box-shadow: 0 24px 70px rgba(0,0,0,.28);
  animation: receiptModalIn .22s ease-out;
}

@keyframes receiptModalIn {
  from { opacity: 0; transform: translateY(18px) scale(.97); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}

.receipt-success-icon {
  width: 64px;
  height: 64px;
  margin: 0 auto 14px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #dcfce7;
  color: #15803d;
  font-size: 34px;
  font-weight: 900;
}

.receipt-title {
  text-align: center;
  font-size: 24px;
  font-weight: 900;
  color: #111827;
}

.receipt-subtitle {
  text-align: center;
  margin-top: 5px;
  font-size: 13px;
  color: #6b7280;
}

.receipt-id-box {
  margin: 20px 0 14px;
  padding: 14px;
  border-radius: 15px;
  background: #f3f4f6;
  text-align: center;
}

.receipt-id-label {
  font-size: 11px;
  font-weight: 800;
  letter-spacing: .8px;
  color: #6b7280;
}

.receipt-id {
  margin-top: 5px;
  font-size: 13px;
  font-weight: 800;
  color: #111827;
  word-break: break-all;
}

.receipt-summary {
  border-top: 1px dashed #d1d5db;
  border-bottom: 1px dashed #d1d5db;
  padding: 13px 0;
}

.receipt-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 7px 0;
  font-size: 14px;
  color: #6b7280;
}

.receipt-row strong {
  color: #111827;
}

.receipt-total-row {
  margin-top: 5px;
  padding-top: 13px;
  border-top: 1px solid #e5e7eb;
}

.receipt-total-row span {
  font-size: 15px;
  font-weight: 900;
  color: #111827;
}

.receipt-total-row strong {
  font-size: 25px;
}

.receipt-change-row strong {
  color: #15803d;
}

.receipt-done-button {
  width: 100%;
  min-height: 54px;
  margin-top: 18px;
  border: none;
  border-radius: 15px;
  background: #111827;
  color: #fff;
  font-size: 15px;
  font-weight: 800;
  cursor: pointer;
}

@media (max-width:480px) {
  .receipt-modal {
    align-items: flex-end;
    padding: 0;
  }
  .receipt-box {
    max-width: none;
    border-radius: 26px 26px 0 0;
    padding: 25px 18px calc(18px + env(safe-area-inset-bottom));
  }
}


/* =================================================
   POS ALERT MODAL
================================================= */

.pos-alert-modal {
  position: fixed;
  inset: 0;
  z-index: 100002;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20px;
}

.pos-alert-overlay {
  position: absolute;
  inset: 0;
  background: rgba(0,0,0,.62);
  backdrop-filter: blur(5px);
}

.pos-alert-box {
  position: relative;
  width: 100%;
  max-width: 390px;
  background: #fff;
  border-radius: 24px;
  padding: 28px 24px 22px;
  box-shadow: 0 24px 70px rgba(0,0,0,.28);
  animation: posAlertIn .20s ease-out;
  text-align: center;
}

@keyframes posAlertIn {
  from { opacity: 0; transform: translateY(18px) scale(.97); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}

.pos-alert-icon {
  width: 64px;
  height: 64px;
  margin: 0 auto 14px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fef3c7;
  color: #d97706;
  font-size: 32px;
  font-weight: 900;
}

.pos-alert-title {
  font-size: 23px;
  font-weight: 900;
  color: #111827;
}

.pos-alert-product {
  margin-top: 8px;
  font-size: 18px;
  font-weight: 800;
  color: #374151;
  word-break: break-word;
}

.pos-alert-message {
  margin-top: 7px;
  font-size: 14px;
  line-height: 1.5;
  color: #6b7280;
}

.pos-alert-stock {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-top: 14px;
  padding: 8px 13px;
  border-radius: 999px;
  background: #f3f4f6;
  color: #374151;
  font-size: 13px;
  font-weight: 800;
}

.pos-alert-button {
  width: 100%;
  min-height: 52px;
  margin-top: 20px;
  border: none;
  border-radius: 15px;
  background: #111827;
  color: #fff;
  font-size: 15px;
  font-weight: 800;
  cursor: pointer;
}

@media (max-width:480px) {
  .pos-alert-modal {
    align-items: flex-end;
    padding: 0;
  }
  .pos-alert-box {
    max-width: none;
    border-radius: 26px 26px 0 0;
    padding: 25px 18px calc(18px + env(safe-area-inset-bottom));
  }
}

/* =================================================
   PAYMENT MODAL
================================================= */

.payment-modal {
  position: fixed;
  inset: 0;
  z-index: 99999;
  display: flex;
  align-items: center;
  justify-content: center;
